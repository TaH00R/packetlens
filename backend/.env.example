# The backend reads process environment variables, not this file automatically.
PACKETLENS_DB_PATH=data/packetlens.db
# Go duration syntax: 720h = 30 days (the suffix d is not supported).
PACKETLENS_RETENTION=720h
PACKETLENS_CLEANUP_INTERVAL=1h

# Rolling median/MAD latency anomaly detection (successful probes only).
PACKETLENS_ANOMALY_WINDOW=60
PACKETLENS_ANOMALY_MIN_SAMPLES=20
PACKETLENS_ANOMALY_MAD_MULTIPLIER=6
PACKETLENS_ANOMALY_MIN_DELTA_MS=10
PACKETLENS_ANOMALY_MAX_AGE=15m
PACKETLENS_ANOMALY_RECOVERY_SAMPLES=3

# Sustained observed failures and confirmed recovery, per probe type/target.
PACKETLENS_INCIDENT_FAILURE_THRESHOLD=3
PACKETLENS_INCIDENT_RECOVERY_THRESHOLD=2
PACKETLENS_INCIDENT_MAX_GAP=30s
